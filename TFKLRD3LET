local function sendToChat(msg)
    pcall(function()
        local tc = TextChatService:FindFirstChild("TextChannels")
        local rbx = tc and tc:FindFirstChild("RBXGeneral")
        if rbx then rbx:SendAsync(msg) return end
        local dc = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        local sm = dc and dc:FindFirstChild("SayMessageRequest")
        if sm then sm:FireServer(msg, "All") end
    end)
end

local function notify(title, content, dur)
    Rayfield:Notify({ Title = title, Content = content, Duration = dur or 3 })
end

local function findPlayer(query)
    if not query or query == "" then return nil end
    local lower = string.lower(query)
    for _, p in ipairs(Players:GetPlayers()) do
        if string.lower(p.Name) == lower or string.lower(p.DisplayName) == lower then return p end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if string.lower(p.Name):find(lower, 1, true) then return p end
    end
    return nil
end

local function findNPC(query)
    if not query or query == "" then return nil end
    local npcs = Workspace:FindFirstChild("NPCs")
    if not npcs then return nil end
    local lower = string.lower(query)
    for _, c in ipairs(npcs:GetChildren()) do
        if c:IsA("Model") and string.lower(c.Name) == lower then return c end
    end
    return nil
end

local function getTargetModel(query)
    local p = findPlayer(query)
    if p and p ~= localPlayer then return p.Character end
    return findNPC(query)
end

local function getHRP(char) return char and char:FindFirstChild("HumanoidRootPart") end
local function getHum(char) return char and char:FindFirstChildOfClass("Humanoid") end

local function getCombatRemote(name)
    local pkg = ReplicatedStorage:FindFirstChild("Packages")
    local knit = pkg and pkg:FindFirstChild("Knit")
    local svcs = knit and knit:FindFirstChild("Services")
    local combat = svcs and svcs:FindFirstChild("CombatService")
    local rf = combat and combat:FindFirstChild("RF")
    return rf and rf:FindFirstChild(name)
end

