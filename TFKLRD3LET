                lbl.Size = UDim2.fromScale(1, 1)
                lbl.BackgroundColor3 = Color3.fromRGB(30, 25, 25)
                lbl.BackgroundTransparency = 0.15
                lbl.BorderSizePixel = 0
                lbl.Font = Enum.Font.GothamBold
                lbl.Text = "WHITELISTED"
                lbl.TextColor3 = Color3.fromRGB(255, 100, 100)
                lbl.TextScaled = true
                lbl.Parent = gui
                Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 6)
                local stroke = Instance.new("UIStroke", lbl)
                stroke.Color = Color3.fromRGB(255, 100, 100)
                stroke.Thickness = 1.25
                pcWhitelistTags[plr] = gui
            end
        end
    end
end

local function stopPcAura()
    if pcAuraHitThread then pcall(function() task.cancel(pcAuraHitThread) end); pcAuraHitThread = nil end
    if pcAuraAnimConn then pcall(function() pcAuraAnimConn:Disconnect() end); pcAuraAnimConn = nil end
    if pcAuraCurrentTarget then setHitbox(pcAuraCurrentTarget, false) end
    for plr in pairs(pcAuraRestore) do setHitbox(plr, false) end
    pcAuraCurrentTarget = nil
end

local function findPcTarget()
    local nearest, closest = nil, S.pcRange
    local myHrp = getHRP(localPlayer.Character)
    if not myHrp then return nil, math.huge end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer and plr.Character and not whitelisted(plr) then
            local oHrp = getHRP(plr.Character)
            local oHum = getHum(plr.Character)
            if oHrp and oHum and oHum.Health > 0 then
                local d = (myHrp.Position - oHrp.Position).Magnitude
                if d < closest then closest = d; nearest = plr end
            end
        end
    end
    return nearest, closest
end

local function blockAnim(track)
    if track and track.Animation and blacklistedAnims[track.Animation.AnimationId] then
        pcall(function() track:Stop() end)
    end
end

local function hookAnimator()
    if not S.noHitAnims then return end
    local char = localPlayer.Character
    local hum = getHum(char)
    if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then return end
    for _, t in ipairs(animator:GetPlayingAnimationTracks()) do blockAnim(t) end
    if pcAuraAnimConn then pcall(function() pcAuraAnimConn:Disconnect() end) end
    pcAuraAnimConn = animator.AnimationPlayed:Connect(blockAnim)
end

RunService.RenderStepped:Connect(function()
    if not S.pcAura then return end
    local target = findPcTarget()
    if not target then
        if pcAuraCurrentTarget then setHitbox(pcAuraCurrentTarget, false); pcAuraCurrentTarget = nil end
        return
    end
    if pcAuraCurrentTarget ~= target then
        if pcAuraCurrentTarget then setHitbox(pcAuraCurrentTarget, false) end
        pcAuraCurrentTarget = target
    end
    setHitbox(target, true)
    if S.noHitAnims then hookAnimator() end
    if not pcAuraHitThread then
        pcAuraHitThread = task.spawn(function()
            while S.pcAura and pcAuraCurrentTarget do
                local target2 = findPcTarget()
                if target2 then
                    local hitRemote = getCombatRemote("Hit")
                    if hitRemote then
                        local hum = getHum(target2.Character)
                        if hum then pcall(function() hitRemote:InvokeServer(hum, target2.Character.HumanoidRootPart.Position) end) end
                    end
                end
                task.wait(1 / math.max(1, S.pcCps))
            end
            pcAuraHitThread = nil
        end)
    end
end)

--═══════════════════════════════════════════════════════════════════
-- MAIN LOOP (TFK movement/farm/TFK anti etc.)
--═══════════════════════════════════════════════════════════════════
local orbitAngle = 0
local lastHealth, lastCFrame
local lastHitTpTime = 0
local hitboxRestore = {}

RunService.Heartbeat:Connect(function(dt)
    if S.bwEnabled then
        local v = math.sin(os.clock() * S.bwSpeed * 2)
        S.titleColor = Color3.new((v + 1) / 2, (v + 1) / 2, (v + 1) / 2)
        if titleLabel then titleLabel.TextColor3 = S.titleColor end
    elseif S.rgbEnabled then
        S.titleColor = Color3.fromHSV((os.clock() * 0.12 * S.rgbSpeed) % 1, 0.8, 1)
        if titleLabel then titleLabel.TextColor3 = S.titleColor end
    end

    local char = localPlayer.Character
    local hum = getHum(char)
    local hrp = getHRP(char)
    if not hum or not hrp then return end

    updateHp()

    if S.hitTp and lastHealth and hum.Health < lastHealth then
        if os.clock() - lastHitTpTime >= 0.35 and lastCFrame then
            lastHitTpTime = os.clock()
            local offset = -lastCFrame.LookVector * 12 + Vector3.new(0, 5, 0)
            hrp.CFrame = lastCFrame + offset
            task.delay(S.hitTpDelay, function()
                local h = getHRP(localPlayer.Character)
                if h and lastCFrame then h.CFrame = lastCFrame end
            end)
        end
    end
    lastHealth = hum.Health
    if hrp then lastCFrame = hrp.CFrame end

    if S.noSlow and hum.WalkSpeed < 16 then hum.WalkSpeed = 16 end

    if S.tpWalk and hum.MoveDirection.Magnitude > 0 then
        hrp.CFrame = hrp.CFrame + hum.MoveDirection * S.tpWalkSpeed
    end

    if S.follow then
        local tHrp = getHRP(getTargetModel(S.followTarget))
        if tHrp then
            local dest = tHrp.Position - tHrp.CFrame.LookVector * S.followDistance
            local flat = Vector3.new(dest.X, tHrp.Position.Y, dest.Z)
            hrp.CFrame = CFrame.lookAt(hrp.Position:Lerp(flat, math.clamp(dt * 5, 0, 1)), tHrp.Position)
        end
    end

    if S.orbit then
        local tHrp = getHRP(getTargetModel(S.orbitTarget))
        if tHrp then
            orbitAngle = orbitAngle + dt * S.orbitSpeed
            local offset = Vector3.new(math.cos(orbitAngle) * S.orbitDistance, 0, math.sin(orbitAngle) * S.orbitDistance)
            hrp.CFrame = CFrame.lookAt(hrp.Position:Lerp(tHrp.Position + offset, math.clamp(dt * 5, 0, 1)), tHrp.Position)
        end
    end

    if S.rush then
        local rp = findPlayer(S.rushTarget)
        local rChar = rp and rp.Character
        local rHrp = rChar and getHRP(rChar)
        local rHum = getHum(rChar)
        if rHrp and rHum and rHum.Health > 0 then
            local dir = Vector3.new(rHrp.CFrame.LookVector.X, 0, rHrp.CFrame.LookVector.Z)
            if dir.Magnitude < 0.001 then dir = Vector3.new(0, 0, -1) else dir = dir.Unit end
            local behind = rHrp.Position - dir * 4
            local dest = Vector3.new(behind.X, rHrp.Position.Y, behind.Z)
            if (dest - hrp.Position).Magnitude > 0.6 then
                hum:Move(Vector3.zero, false)
                hrp.CFrame = CFrame.lookAt(hrp.Position:Lerp(dest, math.clamp(dt * 4, 0, 1)), rHrp.Position)
            else
                hum:Move(Vector3.zero, false)
                hrp.CFrame = CFrame.lookAt(hrp.Position, rHrp.Position)
            end
        end
    end

    if S.autoFarm then
        local rp = findPlayer(S.autoFarmTarget)
        local rChar = rp and rp.Character
        local rHrp = rChar and getHRP(rChar)
        local rHum = getHum(rChar)
        if rHrp and rHum and rHum.Health > 0 then
            local dest
            if S.autoFarmMode == "Above" then dest = rHrp.Position + Vector3.new(0, 3, 0)
            else dest = rHrp.Position - rHrp.CFrame.LookVector * 4 end
            hrp.CFrame = CFrame.lookAt(dest, rHrp.Position)
        end
    end

    if S.hitboxAura then
        local npcs = Workspace:FindFirstChild("NPCs")
        local closestDist, closestPart = S.hitboxDistance, nil
        if npcs then
            for _, npc in ipairs(npcs:GetChildren()) do
                if npc:IsA("Model") then
                    local npcHrp = npc:FindFirstChild("HumanoidRootPart")
                    local npcHum = npc:FindFirstChildOfClass("Humanoid")
                    if npcHrp and npcHum and npcHum.Health > 0 then
                        local d = (hrp.Position - npcHrp.Position).Magnitude
                        if d <= closestDist then closestDist = d; closestPart = npcHrp end
                    end
                end
            end
        end
        if closestPart then
            if not hitboxRestore[closestPart] then
                hitboxRestore[closestPart] = {Size=closestPart.Size, Transparency=closestPart.Transparency,
                    Color=closestPart.Color, Material=closestPart.Material, CanCollide=closestPart.CanCollide}
            end
            closestPart.Size = Vector3.new(S.hitboxSize, S.hitboxSize, S.hitboxSize)
            closestPart.Transparency = 0.5
            closestPart.Color = Color3.fromRGB(255, 80, 80)
            closestPart.Material = Enum.Material.Neon
            closestPart.CanCollide = false
        else
            for part, data in pairs(hitboxRestore) do
                if part and part.Parent then pcall(function()
                    part.Size = data.Size; part.Transparency = data.Transparency
                    part.Color = data.Color; part.Material = data.Material
                    part.CanCollide = data.CanCollide
                end) end
                hitboxRestore[part] = nil
            end
        end
    end
end)

