AnimTab:CreateButton({
    Name = "Apply Animation Pack",
    Callback = function()
        local char = localPlayer.Character
        local hum = getHum(char)
        local animate = char and char:FindFirstChild("Animate")
        if not hum or not animate then notify("Animations", "Character not ready", 2) return end
        if hum.RigType ~= Enum.HumanoidRigType.R15 then notify("Animations", "R15 required", 2) return end

        local pack
        for _, v in ipairs(animPacks) do if v[1] == selectedPack then pack = v break end end
        if not pack then return end

        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then for _, t in ipairs(animator:GetPlayingAnimationTracks()) do t:Stop(0) end end

        local count = 0
        local idle = animate:FindFirstChild("idle")
        if idle then
            local a1, a2 = idle:FindFirstChild("Animation1"), idle:FindFirstChild("Animation2")
            if a1 then a1.AnimationId = "rbxassetid://" .. pack[2]; count = count + 1 end
            if a2 then a2.AnimationId = "rbxassetid://" .. pack[3]; count = count + 1 end
        end

        local map = {
            [4]={"walk","WalkAnim"},[5]={"run","RunAnim"},[6]={"jump","JumpAnim"},
            [7]={"fall","FallAnim"},[8]={"climb","ClimbAnim"},[9]={"swim","Swim"},[10]={"swimidle","SwimIdle"},
        }

        for idx, path in pairs(map) do
            local node = animate
            for _, n in ipairs(path) do node = node:FindFirstChild(n); if not node then break end end
            if node and node:IsA("Animation") then
                node.AnimationId = "rbxassetid://" .. pack[idx]
                count = count + 1
            end
        end

        local enabled = animate.Enabled
        animate.Enabled = false
        task.wait(0.15)
        if animate.Parent then animate.Enabled = enabled end

        notify("Animations", selectedPack .. " applied (" .. count .. " slots)", 3)
    end,
})

