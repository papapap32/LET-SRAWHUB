local blacklistedAnims = {
    ["rbxassetid://78215114906302"]=true, ["rbxassetid://82990592496976"]=true,
    ["rbxassetid://118382180791352"]=true, ["rbxassetid://134836817604323"]=true,
    ["rbxassetid://140420997560896"]=true, ["rbxassetid://90109303183886"]=true,
    ["rbxassetid://72156524420062"]=true,
}
local pcWhitelistTags = {}
local pcAuraCurrentTarget = nil
local pcAuraHitThread = nil
local pcAuraAnimConn = nil
local pcAuraRestore = {}

local function whitelisted(player)
    for _, v in ipairs(S.pcWhitelist) do
        if string.lower(player.Name) == string.lower(v) or string.lower(player.DisplayName) == string.lower(v) then return true end
    end
    return false
end

local function setHitbox(player, hitbox)
    local hrp = getHRP(player.Character)
    if not hrp then return end
    if hitbox then
        if not pcAuraRestore[player] then
            pcAuraRestore[player] = {Size=hrp.Size, Transparency=hrp.Transparency,
                Material=hrp.Material, Color=hrp.Color, CanCollide=hrp.CanCollide, Shape=hrp.Shape}
        end
        pcall(function()
            hrp.Size = Vector3.new(S.pcHitboxSize, S.pcHitboxSize, S.pcHitboxSize)
            hrp.Transparency = S.pcHitboxVis
            hrp.Color = Color3.fromRGB(255, 100, 100)
            hrp.Material = Enum.Material.Neon
            hrp.CanCollide = false
            hrp.Shape = Enum.PartType.Ball
        end)
    else
        local data = pcAuraRestore[player]
        if data and hrp then pcall(function()
            hrp.Size = data.Size; hrp.Transparency = data.Transparency
            hrp.Material = data.Material; hrp.Color = data.Color
            hrp.CanCollide = data.CanCollide; hrp.Shape = data.Shape
        end) end
        pcAuraRestore[player] = nil
    end
end

local function updateWhitelistTags()
    for plr, gui in pairs(pcWhitelistTags) do if gui then gui:Destroy() end end
    pcWhitelistTags = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer and whitelisted(plr) then
            local hrp = getHRP(plr.Character)
            if hrp then
                local gui = Instance.new("BillboardGui")
                gui.Size = UDim2.fromOffset(120, 26)
                gui.StudsOffset = Vector3.new(0, 3.4, 0)
                gui.AlwaysOnTop = true
